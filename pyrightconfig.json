{
  "venvPath": "backend",
  "venv": "venv",
  "extraPaths": [
    "backend",
    "backend/venv/Lib/site-packages"
  ],
  "include": [
    "backend"
  ],
  "exclude": [
    "**/__pyrefly_virtual__/**",
    "**/node_modules",
    "**/__pycache__",
    "backend/venv"
  ],
  "ignore": [
    "**/__pyrefly_virtual__/**"
  ]
}
